# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_TABLE=mqtt_messages

# ── MQTT ──────────────────────────────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=mqtt-supa
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC=z2m/#
MQTT_CLIENT_ID=mqtt-supa

# ── Buffer ────────────────────────────────────────────────────────────
# Messages are held in RAM and sent to Supabase in batches.
# BUFFER_SIZE    — flush when this many messages have accumulated.
# FLUSH_INTERVAL — flush every N seconds regardless of buffer size.
# Lower both values on very low RAM devices (256 MB).
BUFFER_SIZE=20
FLUSH_INTERVAL=5

# ── Fallback ──────────────────────────────────────────────────────────
# When Supabase is unreachable, failed messages are saved here.
# Run retry_failed.py manually to replay them once connectivity returns.
FAILED_DB=failed_messages.db

# ── Urgent messages ───────────────────────────────────────────────────
# Urgent events: occupancy, contact open, tamper, water leak.
#
# false (default) — urgent messages are prepended to the buffer and sent
#                   on the next flush ahead of normal messages.
#                   Recommended for typical home automation setups.
#
# true            — urgent messages bypass the buffer entirely and are
#                   sent immediately on their own thread.
#                   Use only when message throughput is very high and
#                   a few seconds of buffer delay is unacceptable.
URGENT_SKIP_BUFFER=false
